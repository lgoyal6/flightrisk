.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store

# Everything under data/ is reproducible from the CLI and is NOT committed:
#   data/raw/        FDIC API caches, SEC EDGAR documents, raw LLM responses (~700 MB)
#   data/processed/  labels, feature matrix, walk-forward predictions (~200 MB)
data/raw/
data/processed/

# ...except the hand-authored files, which are inputs rather than outputs and must be
# version-controlled: the CERT->CIK crosswalk, the 30 blind extraction labels, and the
# hand-adjudicated label exclusions. data/manual/ is not matched by the rules above, so
# this is documentation of intent rather than a negation.
!data/manual/
